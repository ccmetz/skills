################################################################################
# Example .env file for __PROJECT_SLUG__
#
# Copy this file and rename it to .env
################################################################################

POSTGRES_USER=__PROJECT_SLUG__
POSTGRES_PASSWORD=__PROJECT_SLUG__
POSTGRES_DB=__PROJECT_SLUG__

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Default for local Docker Compose (host = service name in docker-compose.yml):
DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB

# Port forward this port to port 3000 in the app container
LOCAL_APP_PORT=3000

# Port forward this port to port 5432 in the database container
LOCAL_DB_PORT=5432
